# Dev/test: start npm run dev:local from the repository root.
# The bootstrap writes the current local URL and publishable/anon key into ignored .env.local.
VITE_SUPABASE_URL=http://127.0.0.1:29130
VITE_SUPABASE_ANON_KEY=
# Local never connects to a secondary cloud viewer.
VITE_OFFICIAL_VIEW_URL=
VITE_OFFICIAL_VIEW_KEY=
# Vercel Production/main only: configure the Main URL/key on Vercel, not in this file.
# Server-only AI configuration. Never prefix private keys with VITE_.
AI_AGENT_MODEL=openai/gpt-4.1-mini
AI_AGENT_TRANSCRIPTION_MODEL=
AI_GATEWAY_API_KEY=
AI_AGENT_APPROVAL_SECRET=
